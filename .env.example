# Copy to .env (gitignored); the Makefile exports every key to its recipes. Empty values use the defaults.
# Optional local Chromium executable; empty uses the Playwright-installed headless shell.
CHROMIUM_PATH=
# Optional JSON array of extra Chromium arguments for constrained test environments; empty means [].
CHROMIUM_ARGS_JSON=
# Port for `make start` and `make dev`, which serve the generated site in docs/ on 127.0.0.1; empty means 4380.
PORT=
# MongoDB server for `make bench-mongo`, e.g. mongodb://127.0.0.1:27017. The script creates and drops a throwaway database.
MONGODB_URL=
# Comma-separated document counts for `make bench-mongo`; empty means 10000,100000.
BENCH_MONGO_SIZES=
